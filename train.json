json",4,"our","hot"],["o85","q_o2.json",5,"our","hot"],["o86","q_o2.json",6,"our","hot"],["o87","q_o2.json",7,"our","hot"],["o88","q_o2.json",8,"our","hot"],["o89","q_o2.json",9,"our","hot"]],"n":{"free":360,"joy":190,"our":90},"reg":{"bull":120,"bear":120,"range":120},"cards":[{"key":"wuduan","name":"五段背驰","q":"wuduan","one":"跌了「下-上-下-上-下」五段、最后一段跌得更深但 MACD 绿柱反而更短，空头没劲了——但要等金叉再动手，别在半山腰抄。","steps":["先分级别：价格在 40 日线下、MACD 的 DIF 在零轴下，才算「下跌段」（级别不够时判断背驰容易错）。","数段：下跌—反弹—下跌—反弹—下跌，最后一段价格创新低。","比力度：最后一段的绿柱面积比前一段小（或 DIF 低点抬高）= 背驰。","等 MACD 金叉再进，背驰低点做止损。"],"rule":"我们的近似：一轮下跌里至少 3 段 MACD 绿柱、低点一段比一段低，最后两段之间出现背驰，金叉那天出信号。","mistakes":["把下跌途中的一个小反弹当成反转——级别不够就抄底，「每一次抄底都躺在半山腰」。","背驰出现就满仓：背驰只说明跌不动了，不保证涨。"],"unclear":"「线段」怎么划原视频没说清（只说看线段反转）；我们用 MACD 绿柱段代替。","videos":[["千盘试炼401 五段背驰","7694964697078009142"]]},{"key":"beichi","name":"背驰 ≠ 反转","q":"beichi","one":"价格创新低、指标没创新低就是背驰；它只说明空头在衰竭，可能反转，也可能横着磨（时间换空间）。","steps":["必须先「破新低」：价格没创新低就不叫背驰（无破不立）。","MACD 要先回到零轴附近再下去，第二段绿柱比第一段短。","等金叉 + 放量确认，不在绿柱还在变长时动手。","目标先看上一个震荡区（中枢）的位置。"],"rule":"我们的近似：两段绿柱、后段价格新低但绿柱面积更小或 DIF 低点抬高、中间 DIF 回到离零轴 30% 以内，金叉出信号。","mistakes":["把「背离」（指标和价格方向不一样）当「背驰」：没破低的不算。","背驰后不设止损，结果走成横盘再下跌。"],"unclear":"「两中枢背驰」的中枢怎么画原视频没说清。","videos":[["千问解盘 背驰和背离","7663427063696706870"],["千盘试炼379 用缠论背驰抄底真的有用吗","7674235284770327859"],["千盘试炼392 建仓与背驰","7685019335991004467"]]},{"key":"jibie","name":"走势级别：零轴 / 40 日线","q":null,"one":"先分清是大跌还是小回调：MACD 黄白线在零轴下、价格在 40 日线下才是下跌级别；级别搞错就会抄在半山腰。","steps":["DIF/DEA 在零轴上 = 多头，零轴下 = 空头；跌破零轴 = 从多转空。","或者看 40 日线：价格一直被 40 日线压着 = 下跌级别。","同一级别里比较力度（背驰、二买）才有意义。"],"rule":"训练器里 40 日线可以单独打开；MACD 副图零轴有一条线。","mistakes":["拿 5 分钟的背驰去抄日线的底。"],"unclear":"","videos":[["千盘试炼401 五段背驰","7694964697078009142"],["千盘试炼414 MACD 盘感练习","7709808522946415872"]]},{"key":"ermai","name":"背驰后的二买","q":"ermai","one":"背驰后第一次金叉（一买）先别急，等回踩不破背驰低点、MACD 再金叉一次（二买）更稳。","steps":["先有背驰（见上一张卡）。","反弹后回踩，最低价不跌破背驰低点。","MACD 死叉后再次金叉 = 二买，入场。","止损放背驰低点；离场看走势变化。"],"rule":"我们的近似：背驰一买后 5~60 根内先死叉再金叉、期间不破背驰低点 → 第二次金叉出信号。","mistakes":["一买就重仓，回踩时被洗出去。","回踩破了背驰低点还拿着（二买不成立就该走）。"],"unclear":"离场规则原视频只说「看走势变化」，我们用「收盘破止损或 MACD 死叉、最长 40 天」。","videos":[["千盘试炼401 五段背驰","7694964697078009142"],["千问解盘02 用 MACD 解决分型难划分","7664218245188177194"]]},{"key":"sanbi","name":"背驰反转定律：先走三笔","q":null,"one":"一段下跌结束后，至少会走出「上-下-上」三笔的反弹结构；用均线把来回波动排顺，就看得出第几笔。","steps":["背驰金叉后算第一笔上涨。","回踩不破低点是第二笔。","再突破第一笔高点是第三笔（常和二买重合）。"],"rule":"没有单独检验（笔的划分主观）；训练器里「二买」题就是第二笔结束的位置。","mistakes":["第一笔就当成大反转追高。"],"unclear":"三笔怎么数、每笔最少几根 K 线原视频没说清。","videos":[["千盘试炼401 五段背驰","7694964697078009142"],["千问解盘05 笔和线段","7676451275105504555"]]},{"key":"macdfx","name":"用 MACD 金叉代替分型","q":null,"one":"缠论的顶底分型不好划，干脆用 MACD 金叉当底、死叉当顶；金叉还突破前面阴线高点 = 强势。","steps":["底：死叉后再金叉才动手。","强弱：金叉那天突破前一根大阴线高点 = 强势，没突破 = 弱势。","死叉止损；中途的小金叉要等确认。"],"rule":"MACD 金叉单独做买点我们早测过（#/backtest「MACD 金叉」）：和随便买差不多。","mistakes":["每个金叉都买：在下跌途中金叉一样会继续跌。"],"unclear":"他说要「调整 MACD 参数」，具体参数原视频没说清。","videos":[["千问解盘02 用 MACD 解决分型难划分","7664218245188177194"]]},{"key":"sanchong","name":"三重滤网（Joy 版）","q":"sanchong","one":"大方向向上（40 日线在 160 日线上）→ 等回调（跌破 10 日线）→ MACD 金叉、重新站上 10 日线那根 K 线动手。","steps":["第一重定方向：40 日线上穿 160 日线 = 多头（10 / 40 / 160 三根线，每根相差 4 倍）。","第二重不追：等回调，回调不跌破 160 日线。","第三重找那根 K 线：MACD 金叉 + 收盘重新站上 10 日线。","目标先看前高；跌破回调低点就止损；破前高先走一半。"],"rule":"我们的近似：40 日线 > 160 日线且向上；最近 10 根有收盘跌破 10 日线；今天 MACD 金叉且收盘站上 10 日线。","mistakes":["趋势没确认（40 日线还没过 160 日线）就当多头做。","在主力出货区间用三重滤网——他说这时候成功率低。"],"unclear":"他提到把 MACD 参数调成「双倍」一组，转写听不清具体数字，原视频没说清；我们用常规 12/26/9。原版（埃尔德）是周线 + 日线两个周期，他改成 10/40/160 三根均线。","videos":[["千盘试炼408 三重滤网","7699860547642215734"],["三重滤网01 交易体系","7689066073710267691"],["千盘试炼372 三重滤网 + 三级别联立","7668288825537383730"],["千盘破茧11 三重滤网 plus","7663815250499652905"]]},{"key":"w520","name":"520 战法","q":"w520","one":"5 日线上穿 20 日线后，回踩不破 20 日线、再站回 5 日线就上；拉高就走，不恋战。","steps":["5 日线上穿 20 日线（均线多头）。","回调，收盘不跌破 20 日线。","收盘重新站上 5 日线 → 入场。","阳线拉高就短线出局；回踩了可以再进。"],"rule":"我们的近似：金叉后 20 根内、回调期间不破 20 日线、今天收盘重新站上 5 日线。","mistakes":["拿太久：这是短线结构，拉高不走容易坐电梯。","跌破 20 日线还不走。"],"unclear":"","videos":[["千盘试炼370 520 战法","7666369796631465254"],["千盘试炼393 三重滤网 + 520","7686433969344105734"]]},{"key":"gongji","name":"攻击性三步曲","q":"gongji","one":"一直被一根均线压着的票，等放量突破这根「生命线」，再等缩量回踩不破，才上车。","steps":["第一步：找到一直压着价格的「下跌核心生命线」。","第二步：等放量阳线突破它（突破当天不追）。","第三步：等缩量回踩、不跌破突破阳线的低点，再企稳收阳时入场。","止损放在突破阳线低点 / 震荡区间；高位十字星、天量天价先走一半。"],"rule":"我们的近似：生命线用 60 日线；放量 = 前 20 日均量 2 倍；缩量 = 回踩期间均量不到突破日 60%。","mistakes":["第二步一突破就追进去（他反复强调要等第三步）。","反包阳线当成再起飞——「反包是诱惑」。"],"unclear":"「核心生命线」用哪根均线原视频没说清（画面上是手画的一根线）。","videos":[["千盘试炼403 攻击性三步曲","7696430609173925171"],["千盘试炼376 攻击性三步曲","7671608724309544219"],["千盘试炼348 攻击性三步曲","7653766373792845110"]]},{"key":"shenlong","name":"神龙系","q":null,"one":"底部震荡区里温和放量（主力在买）→ 放量突破「强弱分界线」→ 缩量回踩分界线不破，博主升段；赔率要 4 比 1 以上才做。","steps":["画两根线：大海 = 前面高点的压力区，小海 = 震荡区中间的强弱分界线。","震荡区里要看到温和放量，缩量横盘不算。","放量突破小海后，等缩量回踩到小海附近（或回撤约 50%）企稳再进。","止损放回踩低点下方；目标看大海，盈亏比 ≥ 4:1。"],"rule":"没有检验：大海 / 小海靠手画，规则说不清。","mistakes":["回踩跌破小海还扛单（他说跌破了就等重新企稳）。","被主力洗下车：二级出货平台没出现前就先跑了。"],"unclear":"大海 / 小海具体怎么画原视频没说清（会员课有完整拆解）。","videos":[["千盘试炼407 神龙系","7699854985017707812"],["千盘试炼413 神龙系","7708247196373617920"],["千盘试炼261 神龙系精讲","7618048775801588992"]]},{"key":"dibu","name":"底部三步曲 / 周线擎天柱","q":"gongji","one":"找到主力建仓区 → 等放量突破 → 等回踩不破再上；和攻击性三步曲是同一套思路，换成看成交量和建仓区。","steps":["建仓区：底部出现大阳线 + 大成交量（主力进场）。","放量突破建仓区 / 平均成本区。","缩量回踩不破建仓区低点 → 入场；阴线结构出现、跌破关键阳线就减仓或出局。"],"rule":"训练器里归到「攻击性三步曲」题（量化近似相同）。","mistakes":["没等回踩就追突破。"],"unclear":"「建仓量」多大算标准原视频没说清。","videos":[["千盘试炼356 底部三步曲","7657120277754662198"],["千盘试炼354 周线擎天柱","7656379609503501620"]]},{"key":"tiaozheng","name":"技术性调整怎么加仓、什么时候走","q":null,"one":"放量进攻后缩量回踩是加仓机会；拉高后天量天价、十字星有分歧先走一半，跌破阳线低点全走。","steps":["突破时先做一半，回踩不破阳线低点再加。","大阳线后出现十字星 / 天量 = 分歧，先走一半。","回调后出现小背驰、顶部背驰再走一半。"],"rule":"没有单独检验；训练器里「卖一半」按钮就是为这个练的。","mistakes":["满仓一把梭，回踩时拿不住。","一点分歧就全卖，卖飞主升段。"],"unclear":"","videos":[["千盘试炼404 技术性调整","7697098678560935222"],["千盘试炼355 类三买起爆","7656737100913495347"]]},{"key":"erbo","name":"二波结构","q":null,"one":"主力第一波拉不出去、自己被套，往往会回踩后再拉第二波解套；等回踩出阳线、以阳线低点做防守。","steps":["先找第一波：放量拉升后回落。","回踩缩量、不破关键阳线低点。","出现新阳线再进，跌破阳线低点走。"],"rule":"没有检验（「主力被套」要看中线筹码，规则说不清）。","mistakes":["第一波顶上追进去。"],"unclear":"中线主力成本区怎么判断原视频没说清。","videos":[["千盘试炼410 二波结构","7699873874573266176"],["千盘试炼341 同级别二波模式","7650425323435216128"]]},{"key":"zhuigao","name":"追高的坑（表弟追高）","q":"zhuigao","one":"连涨几天、离均线很远时冲进去，常常买在主力出货的地方；该等回踩不等，是表弟最常犯的错。","steps":["看离 20 日线多远：远超 15% 就别追。","看量：天量 + 长上影 = 有人在卖。","想要就等回踩不破再说。"],"rule":"我们的近似：5 天涨超 15%、收盘创 10 日新高、比 20 日线高 15% 以上，第二天开盘追。","mistakes":["怕错过，越涨越想买。"],"unclear":"","videos":[["千盘试炼399 表弟是真喜欢追高啊","7691350098999020863"]]}],"our":[{"key":"sgrade","name":"S 级买点","src":"#/todo · stockscope 个股透视「今日买卖点」","rule":"放量突破 / 缩量回踩 / 超跌反弹 / MACD 金叉等 11 条规则里，打分 ≥ 90 且趋势、动量、量能、盈亏比、不追高五项都满分 = S 级；按 止损 3% / 止盈 6% / 最长 10 天 走。","lab":"胜率实验室（2026-11-24）：S 级买点 282 笔，赢的比例 42%，每笔 +0.17%——接近五五开，靠赚多亏少和小仓位，不是高胜率。","link":"#/labs/winrate","exit":"s"},{"key":"etfdip","name":"ETF 超跌反弹（今日一票同类）","src":"#/pick 今日一票","rule":"ETF 5 天跌超 10% → 第二天开盘买 → 收盘站上 5 日线就卖（最长 10 天）。","lab":"胜率实验室（2026-11-24）：680 笔，赢的比例 76%、每笔扣成本 +2.29%、前后两段都赚；但 8 年只有 42 段行情，2026 年明显变弱（今年每笔约 0）。实盘预期打折到六成左右。","link":"#/labs/winrate","exit":"ma5"},{"key":"hot","name":"人气榜前 20 追高","src":"#/hot 人气榜剖析","rule":"东方财富人气榜第一次冲进前 20 → 第二天开盘买 → 拿 5 天。","lab":"人气榜检验（2026-11-24）：近一年人气前 20 第二天买、拿 5 天平均 −1.37%、赚钱的 41%，比随便买少赚；上榜不是买入理由。","link":"#/labs/hot_rank","exit":"h5"}],"lab":{"beichi":{"v":"❌","ie":{"n":185,"months":63,"win":36.21621621621622,"net":0.6752047233942161,"ctrl":0.7296086510558736,"ex":-0.05440392766165752,"t":-0.07076959115889928,"exA":-0.09118892945041338,"nA":44,"exB":-0.04292492001126557,"nB":141,"hold":16.086486486486486},"big":{"n":1182,"months":173,"win":39.50930626057529,"net":1.4883839397385845,"ctrl":1.3181362749677499,"ex":0.17024766477083483,"t":-0.015454059499594323,"exA":1.1927339659575509,"nA":457,"exB":-0.47427128645996397,"nB":725,"hold":16.487309644670052}},"wuduan":{"v":"❌","ie":{"n":70,"months":27,"win":31.428571428571427,"net":0.7031372362508492,"ctrl":0.9215104644409402,"ex":-0.21837322819009125,"t":0.2168326223426867,"exA":-1.52